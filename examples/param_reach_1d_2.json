{
  "system": {
    "type": "cartesian",
    "state_vars": ["S1", "S2"],
    "param_vars": ["P1", "P2", "P3"],
    "noise_vars": ["W1"],
    "state_bounds": [[-10, 10], [0, 1]],
    "param_bounds": [[0.0, 1.0], [0.0, 1.0], [0.0, 1.0]],
    "initial_region": {
      "bounds": [[0.0, 1.0], [0.999, 1.111]]
    },
    "dynamics": [
      {
        "condition": "-10 <= S1 <= 10",
        "transforms": {
          "S1": "(+ P1 (+ (* P2 S2) (* P3 W1)))",
          "S2": "(+ S2 -1)"
        }
      }
    ],
    "noise_distribution": {
      "type": "uniform",
      "params": {"lower": [0], "upper": [1]}
    }
  },
  "target_region": {
    "bounds": [[0.0, 1.0], [-0.111, 0.111]]
  },
  "enable_param_refinement": true,
  "param_refinement_threshold": 0.1,
  "target_probability": 0.75,
  "degree": 1,
  "smt_solver": "z3",
  "entailment_solver": "farkas",
  "output_smt_path": "./tmp/temporary_polyhorn_input.smt2"
}
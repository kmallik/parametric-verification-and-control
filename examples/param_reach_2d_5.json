{
  "system": {
    "type": "cartesian",
    "state_vars": ["S1","S2"],
    "param_vars": ["P1"],
    "noise_vars": ["W1"],
    "control_vars": ["U1"],
    "state_bounds": [[-2, 150], [-2, 150]],
    "param_bounds": [[-1.0, 1.0]],
    "control_bounds":[[0, 0.6]],
    "initial_region": {
      "bounds": [[2, 3], [2,3]]
    },
    "dynamics": [
      {
        "condition": "-2 <= S1 <= 0 and -2 <= S2 <= 0",
        "transforms": {
          "S1": "(+ S1 0)",
          "S2": "(+ S2 0)"
        }
      },
      {
        "condition": "S1 >= 100 and 0 <= S2 <= 100",
        "transforms": {
          "S1": "(+ S1 0)",
          "S2": "(+ S2 (+ U1 (+ W1 P1)))"
        }
      },
      {
        "condition": "S1 >= 100 and S2 >= 100",
        "transforms": {
          "S1": "(+ S1 0)",
          "S2": "(+ S2 0)"
        }
      }
    ],
    "noise_distribution": {
      "type": "uniform",
      "params": {"lower": [-0.75], "upper": [-0.25]}
    }
  },
  "target_region": {
    "bounds": [[90, 150], [90, 150]]
  },
  "enable_param_refinement": false,
  "param_refinement_threshold": 0.25,
  "cutoff_time_per_smt_query": 10,
  "parallel_refinement": true,
  "target_probability": 1,
  "degree": 1,
  "smt_solver": "mathsat",
  "entailment_solver": "farkas",
  "output_smt_path": "./tmp/temporary_polyhorn_input.smt2"
}
{
  "system": {
    "type": "cartesian",
    "state_vars": ["S1"],
    "param_vars": ["P1"],
    "noise_vars": ["W1"],
    "control_vars": ["U1"],
    "state_bounds": [[-2, 150]],
    "param_bounds": [[0.9, 1.0]],
    "control_bounds":[[0, 0.6]],
    "initial_region": {
      "bounds": [[2, 3]]
    },
    "dynamics": [
     {
        "condition": "-2 <= S1 <= 0",
        "transforms": {"S1": "(+ S1 0)"}
      },
      {
        "condition": "0 <= S1 <= 9",
        "transforms": {"S1": "(+ (* S1 S1) (+ U1 (+ W1 P1)))"}
      },
      {
        "condition": "10 <= S1 <= 100",
        "transforms": {"S1": "(+ S1 (+ U1 (+ W1 P1)))"}
      },
      {
        "condition": "S1 >= 100",
        "transforms": {"S1": "(+ S1 0)"}
      }
    ],
    "noise_distribution": {
      "type": "uniform",
      "params": {"lower": [-0.75], "upper": [-0.25]}
    }
  },
  "target_region": {
    "bounds": [[90, 150]]
  },
  "enable_param_refinement": false,
  "param_refinement_threshold": 0.1,
  "cutoff_time_per_smt_query": 30,
  "parallel_refinement": true,
  "target_probability": 0.001,
  "degree": 2,
  "smt_solver": "mathsat",
  "entailment_solver": "handelman",
  "output_smt_path": "./tmp/temporary_polyhorn_input.smt2"
}
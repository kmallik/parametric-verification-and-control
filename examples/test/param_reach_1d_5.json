{
    "system": {
        "type": "cartesian",
        "state_vars": ["S1"],
        "param_vars": ["P1"],
        "noise_vars": ["W1"],
        "control_vars": ["U1"],
        "state_bounds": [
            [-1, 1]
        ],
        "param_bounds": [
            [-0.1, 0.1]
        ],
        "control_bounds": [
            [0, 0.1]
        ],
        "initial_region": {
            "bounds": [
                [-0.8, -0.7]
            ]
        },
        "dynamics": [
            {
                "condition": "-1 <= S1 <= 1",
                "transforms": {
                    "S1": "(* S1 S1)"
                }
            },
            {
                "condition": "S1 <= -1",
                "transforms": {
                    "S1": "(+ S1 0)"
                }
            },
            {
                "condition": "S1 >= 1",
                "transforms": {
                    "S1": "(+ S1 0)"
                }
            }
        ],
        "noise_distribution": {
            "type": "uniform",
            "params": {
                "lower": [-0.75],
                "upper": [-0.25]
            }
        }
    },
    "target_region": {
        "bounds": [
            [-0.1, 0.1]
        ]
    },
    "param_refinement_threshold": 0.1,
    "cutoff_time_per_smt_query": 30,
    "target_probability": 1,
    "degree": 2,
    "smt_solver": "mathsat",
    "entailment_solver": "handelman",
    "output_smt_path": "./tmp/temporary_polyhorn_input.smt2",
    "refinement_mode": "none",
    "logfile": "./results.log"
}

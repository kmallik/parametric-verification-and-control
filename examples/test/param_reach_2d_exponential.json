{
    "system": {
        "type": "cartesian",
        "state_vars": ["S1", "S2"],
        "param_vars": ["P1"],
        "noise_vars": ["W1"],
        "state_bounds": [
            [-2.2, 2.2],
            [-2.2, 2.2]
        ],
        "param_bounds": [
            [-1.0, 1.1]
        ],
        "initial_region": {
            "bounds": [
                [-1.0, -0.8],
                [-1.0, -0.8]
            ]
        },
        "dynamics": [
            {
                "condition": "-2 <= S1 <= 2 and -2 <= S2 <= 2",
                "transforms": {
                    "S1": "(* 0.1 S1)",
                    "S2": "(* 0.1 S2)"
                }
            },
            {
                "condition": "S1 <= -2 and S2 <= -2",
                "transforms": {
                    "S1": "(+ S1 0)",
                    "S2": "(+ S2 0)"
                }
            },
            {
                "condition": "S1 <= -2 and S2 >= 2",
                "transforms": {
                    "S1": "(+ S1 0)",
                    "S2": "(+ S2 0)"
                }
            },
            {
                "condition": "S1 >= 2 and S2 <= -2",
                "transforms": {
                    "S1": "(+ S1 0)",
                    "S2": "(+ S2 0)"
                }
            },
            {
                "condition": "S1 >= 2 and S2 >= 2",
                "transforms": {
                    "S1": "(+ S1 0)",
                    "S2": "(+ S2 0)"
                }
            }
        ],
        "noise_distribution": {
            "type": "uniform",
            "params": {
                "lower": [-0.01],
                "upper": [0.01]
            }
        }
    },
    "target_region": {
        "bounds": [
            [-0.1, 0.1],
            [-0.1, 0.1]
        ]
    },
    "param_refinement_threshold": 0.1,
    "cutoff_time_per_smt_query": 60,
    "target_probability": 0.9,
    "degree": 1,
    "smt_solver": "z3",
    "entailment_solver": "farkas",
    "output_smt_path": "./tmp/temporary_polyhorn_input.smt2",
    "refinement_mode": "none",
    "logfile": "./results.log"
}

{
    "system": {
        "type": "cartesian",
        "state_vars": ["S1"],
        "noise_vars": ["W1"],
        "control_vars": ["U1"],
        "state_bounds": [
            [-2, 150]
        ],
        "control_bounds": [
            [0, 1]
        ],
        "initial_region": {
            "bounds": [
                [2, 3]
            ]
        },
        "dynamics": [
            {
                "condition": "-2 <= S1 <= 0",
                "transforms": {
                    "S1": "(+ S1 0)"
                }
            },
            {
                "condition": "0 <= S1 <= 100",
                "transforms": {
                    "S1": "(+ S1 (+ W1 U1))"
                }
            },
            {
                "condition": "S1 >= 100",
                "transforms": {
                    "S1": "(+ S1 0)"
                }
            }
        ],
        "noise_distribution": {
            "type": "uniform",
            "params": {
                "lower": [-1],
                "upper": [0]
            }
        }
    },
    "target_region": {
        "bounds": [
            [90, 150]
        ]
    },
    "target_probability": 1,
    "degree": 1,
    "smt_solver": "z3",
    "entailment_solver": "farkas",
    "output_smt_path": "./tmp/temporary_polyhorn_input.smt2",
    "refinement_mode": 2,
    "logfile": "./results.log"
}
